  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|mcp__github__merge_pull_request|mcp__github__create_pull_request|mcp__github__push_files|mcp__github__create_or_update_file|mcp__github__delete_file|mcp__github__create_branch|mcp__github__add_issue_comment|mcp__github__pull_request_review_write|mcp__github__update_pull_request|mcp__Supabase__apply_migration|mcp__Supabase__execute_sql|mcp__Supabase__deploy_edge_function",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/wcr-post-tool-mark.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/wcr-stop-reminder.sh"
          }
        ]
      }
    ]
  }
}
