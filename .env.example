# video-article 환경변수 예시 — 실제 값은 커밋 금지(.env 는 .gitignore 처리됨)

# --- 논문 소스 ---
# OpenAlex: API 키 불필요. polite pool 사용을 위한 연락처 이메일(리뷰 D1)
OPENALEX_MAILTO=you@example.com
# arXiv: 키 불필요. 요청 User-Agent 에 표기할 연락처
ARXIV_CONTACT=you@example.com

# --- 리포트 팩토리(하루 한 리포트) — ARIA 연동 (docs/deviation-report-factory.md, PFD3) ---
# 전송방식 우선순위: ARIA_MCP_URL(MCP) → ARIA_BASE(REST) → 둘 다 비면 fixture(로컬/테스트).
# ★ 사용자의 ARIA 는 REST 가 아니라 MCP 서버다. ARIA_MCP_URL 하나면 라이브 연결됨(인증 토큰이 URL 경로에 포함).
ARIA_MCP_URL=              # ARIA MCP 엔드포인트 URL(토큰 포함) — 프로덕션 라이브 경로
ARIA_BASE=                 # 순수 REST ARIA base URL(대안, 선택). MCP 미설정 시에만 사용
ARIA_API_KEY=              # 순수 REST ARIA 키 (ARIA_BASE 설정 시)

# Source Contract — 원문 전문 확보 (작업지시서 영상엔진품질 v3 §4, Phase 0 결정 §8-1 (가))
# ★ 전문은 저장하지 않는다. Fact Sheet 추출 직전에 ARIA 에서 불러 프롬프트에만 넣는다.
SOURCE_INJECT_FULLTEXT=true   # false 면 예전처럼 요약만 보고 추출(되돌리기 스위치)
SOURCE_FULLTEXT_MAX_CHARS=40000  # 전문 주입 상한(≈30k 토큰). 넘으면 자르고 그 사실을 남김
REPORT_COLLECT_RESEARCH=true  # ARIA 포털 리포트(정식 리포트) 수집 on/off
ARIA_RESEARCH_LIMIT=40        # search_research 상위 N
ARIA_RESEARCH_STATUS=selected # 선별 통과분만(빈값=전체)

# --- 화제성 신호 소스 ---
# Reddit 무료 앱 등록 (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=video-article/0.1 by your_reddit_id
# Hacker News(Algolia): 키 불필요

# --- LLM (핵심 비용) ---
ANTHROPIC_API_KEY=
# Gemini(재미나이) 대체 채점용 — 무료 등급(https://aistudio.google.com/apikey).
# MODEL_SCORING=gemini-2.5-flash 처럼 모델 id 가 'gemini' 면 이 키로 호출됨.
GEMINI_API_KEY=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=         # 클라이언트 공개 가능
SUPABASE_SERVICE_KEY=      # 서버/엔진 전용 — 절대 클라이언트 노출 금지

# --- Supabase Edge Function (초안 클라우드 자동생성 generate-draft) ---
# 기본 백엔드는 Gemini(무료 등급). 함수 시크릿으로 등록:
#   supabase secrets set GEMINI_API_KEY=…
# (SUPABASE_URL·SUPABASE_SERVICE_ROLE_KEY 는 Edge 런타임에 기본 주입됨)
# Anthropic 을 쓰려면 대신 ANTHROPIC_API_KEY 를 넣고 MODEL_FACTSHEET/MODEL_SCRIPT/MODEL_SELFCHECK 를 claude-* 로 지정.
# 선행조건: 로그인 이메일을 app_allowed_emails 에 넣어야 요청/상태조회가 RLS 통과.
#   insert into app_allowed_emails(email) values ('you@example.com');

# --- 영상화 파이프라인 (P-V0/P-V1, docs/deviation-render-pipeline.md) ---
# 지시서 생성 모델(엔진 기본 claude-sonnet-4-6; 엣지 함수 기본 gemini-2.5-flash). id 가 'gemini' 면 Gemini 로 라우팅.
MODEL_DIRECTIVE=
# 제공자 선택: placeholder(키 불필요·조립검증) | gemini(이미지) | edge(TTS) | higgsfield(I2V). P-V0 기본 placeholder.
IMAGE_PROVIDER=placeholder
TTS_PROVIDER=placeholder
VIDEO_PROVIDER=placeholder
# 편당 에셋 생성 비용 상한(USD). 초과 시 렌더 중단·알림.
RENDER_BUDGET_CAP_USD=1.0
# P-V1 유료 제공자 키(무료 우선이라 미설정 가능). 상업 라이선스 확인 필수.
ELEVENLABS_API_KEY=
HIGGSFIELD_API_KEY=

# --- 숏폼 규격 v2 (docs/규격서_숏폼_v2.md, DV7~DV11) — 값 비우면 코드 기본값 ---
# ⑤ 이중언어: 언어별 Edge TTS 보이스·자막 폰트.
EDGE_TTS_VOICE=ko-KR-SunHiNeural      # KO 보이스(기존)
EDGE_TTS_VOICE_EN=en-US-AriaNeural    # EN 보이스
SUBTITLE_FONT_NAME_EN=Montserrat      # EN 자막 폰트(러너 설치 시. 미설치면 libass 폴백)
# ② 자막 앵커 마스터 플랫폼: tiktok | reels | shorts | fb_reels (기본 tiktok=가장 빡빡).
DEFAULT_PLATFORM=tiktok
# ④ 더킹 방식: precomputed_envelope(기본·펌핑없음) | sidechain(실시간 폴백).
DUCK_METHOD=precomputed_envelope

# --- 운영 상수(코드 기본값이 있으나 환경에서 덮어쓸 수 있음) ---
TIMEZONE=Asia/Seoul        # 수집/배치 기준 (리뷰 D5)
COLLECT_WINDOW_DAYS=10     # 수집 윈도우 일수 (HN 추천이 붙을 시간 확보 위해 10일)
SCORE_CUTOFF_N=150         # 1차 필터 후 저장 상한
# 수집 커버리지 v2 (플래그십 누락 해결, docs/deviation-collection-coverage-v2.md) — 비우면 코드 기본값
FLAGSHIP_WATERMARK_OVERLAP_HOURS=18   # created_date 워터마크 경계 중첩(누락 방지)
FLAGSHIP_PUB_LOWER_BOUND_DAYS=90      # 재색인 노이즈 차단용 게재일 하한
FLAGSHIP_BACKFILL_DAYS=90             # 초기 백필/최초 워터마크 소급 기간
PRESS_ENABLED=true                    # 과학 언론 RSS 수집(발견+화제성). 파서 실패는 무시
PRESS_TITLE_SIMILARITY_MIN=0.94       # 언론 제목 유사도 자동연결 임계
DAILY_BATCH_SIZE=20        # 그날 편성할 상위 편수 (10→20)
PEER_REVIEWED_ONLY=true    # 동료 리뷰(저널 article)만 수집 — 품질 향상
SCORE_LIMIT=               # 1회 채점 편수 제한(비용 통제). 비우면 전체
ENABLE_SIGNIFICANCE_BOOST=false  # ④ 학술중요성 보정 (리뷰 D6, P0 기본 off)

# 대시보드에서 승인·"지금 렌더" 시 GitHub Actions 렌더 워커(render.yml)를 즉시 트리거하기 위한 토큰.
# fine-grained PAT(대상 레포: video-article, 권한: Actions=Read/Write). 서버 전용, NEXT_PUBLIC_ 금지.
# 미설정 시 렌더 잡은 큐에만 쌓이고 워커는 수동 실행(폴백).
GITHUB_DISPATCH_TOKEN=
RENDER_REPO=<owner>/<repo>
# 대시보드(Vercel) 서버 전용 — NEXT_PUBLIC_ 금지
OPERATOR_KEY=
EDGE_INVOKE_SECRET=
RENDER_WORKFLOW=render.yml
RENDER_REF=main
PUBLISH_WORKFLOW=publish.yml         # 유튜브 업로드 워커 워크플로(대시보드 트리거용)

# --- 유튜브 자동 업로드 (P-V2 승인 이탈, docs/deviation-youtube-upload.md) ---
# 채널 업로드는 서비스계정 불가 → OAuth 리프레시 토큰. 클라이언트는 채널 공통, 토큰은 언어(채널)별.
# 설정법(리프레시 토큰 발급)은 docs/deviation-youtube-upload.md 참조. 서버/엔진 전용, NEXT_PUBLIC_ 금지.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN_KO=            # 논문(과학) 한국어 채널 리프레시 토큰
YOUTUBE_REFRESH_TOKEN_EN=            # 논문(과학) 영어 채널 리프레시 토큰
# (리포트 전용 토큰은 채널 통합으로 불필요 — 리포트도 YOUTUBE_REFRESH_TOKEN_KO 를 쓴다.
#  docs/specs/20260730-report-merge-into-paper-ko.md §4 되돌리기 때 복원)
YOUTUBE_DEFAULT_PRIVACY=private      # private | unlisted | public (기본 private)
YOUTUBE_CATEGORY_ID=27               # 27=Education
YOUTUBE_UPLOAD_ENABLED=true

# --- 유튜브 쇼츠 성과 수집 (P-V3 승인 이탈, docs/deviation-youtube-analytics.md) ---
# 읽기 전용. 업로드 토큰(youtube.upload)엔 조회 권한이 없어 조회 스코프(youtube.readonly +
# yt-analytics.readonly) 리프레시 토큰을 따로 발급한다. 발급법은 docs/deviation-youtube-analytics.md.
# 비워두면 위 YOUTUBE_REFRESH_TOKEN_{KO,EN} 로 폴백(업로드 토큰을 조회 스코프 포함해 재발급한 경우).
YOUTUBE_ANALYTICS_REFRESH_TOKEN_KO=  # 한국어 채널 조회 토큰(비우면 업로드 토큰 폴백)
YOUTUBE_ANALYTICS_REFRESH_TOKEN_EN=  # 영어 채널 조회 토큰(비우면 업로드 토큰 폴백)
# 조회 전용 OAuth 클라이언트(선택). 비우면 위 YOUTUBE_CLIENT_ID/SECRET(업로드용) 로 폴백.
# 업로드가 쓰는 GCP 프로젝트를 몰라도/건드리기 싫어도 새 프로젝트에서 조회만 독립적으로 세팅 가능.
YOUTUBE_ANALYTICS_CLIENT_ID=
YOUTUBE_ANALYTICS_CLIENT_SECRET=
YOUTUBE_ANALYTICS_WINDOW_DAYS=7      # 최근 며칠 치 쇼츠를 볼지(사용자 요청 "지난 일주일"=7)
YOUTUBE_SHORTS_MAX_SEC=180           # 이 길이(초) 이하면 쇼츠로 집계(유튜브 정책 60→180)
YOUTUBE_ANALYTICS_ENABLED=true
# 성과 리포트(일간/주간/월간 + 하이브리드 분석, 대시보드 /analytics/report) — engine.perf_report
YOUTUBE_ANALYTICS_DAILY_LOOKBACK_DAYS=90   # 채널 날짜별 시계열 수집 기간(주/월 집계용)
MODEL_PERF_REPORT=claude-sonnet-4-6        # 분석 문장화 모델. id 가 'gemini' 면 Gemini 로 라우팅
PERF_LOW_RETENTION_PCT=40                  # 평균 시청 지속률 이 값(%) 미만이면 '개선 필요' 후보
PERF_TOP_N=3                               # 리포트 상/하위 영상 개수
